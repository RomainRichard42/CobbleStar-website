{
  "name": "cobblestar",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "next dev",
    "preview:admin": "node scripts/local-admin-preview.mjs",
    "build": "next build --webpack && node scripts/optimize-public-assets.mjs && astro build && node scripts/compose-public-site.mjs",
    "build:site": "next build --webpack && node scripts/optimize-public-assets.mjs && astro build && node scripts/compose-public-site.mjs",
    "build:api": "npm --prefix api run build",
    "package:kinetic": "node scripts/package-kinetic.mjs",
    "ci": "npm run lint && npm run build:site && npm --prefix api test && npm run test:public && npm run package:kinetic",
    "lint": "eslint app",
    "dev:public": "astro dev --host 127.0.0.1",
    "test:public": "node --test scripts/test-public-site.mjs scripts/test-dex-motion.mjs scripts/test-collection-session.mjs",
    "audit:seo": "node scripts/seo-audit.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "astro": "7.4.2",
    "molang": "2.0.1",
    "next": "16.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.186.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "sharp": "0.35.5",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "CobbleStar"
}
