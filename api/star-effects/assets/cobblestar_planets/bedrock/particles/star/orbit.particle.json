{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "cobblestar_planets:star_orbit",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "cobblestar_planets:textures/particles/star/blue_star"
      }
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": false
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1.8
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ],
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.065,
          0.065
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": 16
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.35
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(v.particle_random_1 * 360 + v.particle_age * 240) * 0.65 * math.clamp(q.entity_size,0.7,2.5)",
          "(v.particle_age - 0.55) * math.clamp(q.entity_size,0.7,2.5)",
          "math.sin(v.particle_random_1 * 360 + v.particle_age * 240) * 0.65 * math.clamp(q.entity_size,0.7,2.5)"
        ]
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.3,
          0.7,
          1,
          "math.clamp((1.35-v.particle_age)*4,0,1)"
        ]
      }
    }
  }
}
