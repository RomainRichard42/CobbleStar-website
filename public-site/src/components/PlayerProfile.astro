---
const {mobile=false}=Astro.props;
---
<div class:list={['player-profile',{'player-profile-mobile':mobile}]}>
  <a class={mobile?'account-menu-link':'astral-account'} data-account-link href="/compte/">
    <span class="account-avatar" aria-hidden="true" hidden><img alt="" width="32" height="32" referrerpolicy="no-referrer" hidden/><b hidden></b></span>
    <span class="player-identity"><strong data-player-name>Mon compte</strong><small data-player-caption>Connexion Discord</small></span>
  </a>
  <a class="player-balance" data-player-balance href="/boutique/" hidden><img src="/astral/assets/stars-96-v3.webp" alt="" width="32" height="26"/><span><b data-stars-value>—</b> Stars</span></a>
</div>
