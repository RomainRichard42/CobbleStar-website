---
import type {WikiArticle} from '../../../app/wiki/wiki-types';
const {articleId,articles}=Astro.props as {articleId:string;articles:WikiArticle[]};
const published=new Set(articles.map(article=>article.id));
const paths:Record<string,{title:string;intro:string;steps:{title:string;text:string;icon:string;links:{title:string;href:string;guide?:string}[]}[]}>={
 welcome:{title:'Ton parcours pour bien commencer',intro:'Le serveur prépare son ouverture. Voici ce que tu peux préparer maintenant et les repères à garder pour ta première connexion.',steps:[
  {title:'Prépare le bon accès',text:'Il te faudra Minecraft Java et le pack CobbleStar. Tu peux déjà consulter les prérequis et retrouver le bon compte Discord.',icon:'cobblemon-pc.png',links:[{title:'Les prérequis pour rejoindre',href:'/rejoindre/'},{title:'Comprendre la liaison des comptes',href:'/wiki/compte/',guide:'compte'}]},
  {title:'Prends tes repères dans le jeu',text:'À l’ouverture, /menu ouvrira la StarWatch. Le journal /quetes te permettra de choisir un premier objectif et de suivre sa progression.',icon:'cobblemon-pc.png',links:[{title:'Choisir et suivre une quête',href:'/wiki/quests/',guide:'quests'},{title:'Choisir une destination',href:'/wiki/mondes/',guide:'mondes'}]},
  {title:'Prépare ta première sortie',text:'Choisis une espèce, vérifie ses conditions de rencontre et garde de quoi soigner ton équipe avant de partir.',icon:'ultra-ball.png',links:[{title:'Le guide de capture',href:'/wiki/capture/',guide:'capture'},{title:'Chercher un Pokémon dans le Pokédex',href:'/wiki/pokedex/'}]},
 ]},
 capture:{title:'Du Pokémon recherché à ta prochaine sortie',intro:'Ces repères utilisent la configuration de CobbleStar. Le serveur est encore en préparation ; tu peux déjà choisir tes objectifs sur le site.',steps:[
  {title:'Vérifie la bonne fiche',text:'Compare la forme, les conditions de rencontre et les évolutions. Un biome compatible, à lui seul, ne garantit pas une apparition.',icon:'cobblemon-pc.png',links:[{title:'Ouvrir le Pokédex',href:'/wiki/pokedex/'},{title:'Comprendre les apparences Star',href:'/wiki/pokemon-star/',guide:'pokemon-star'}]},
  {title:'Prépare l’équipe et le retour',text:'À l’ouverture, prévois des Balls, des soins, une place de stockage et un point de retour. Choisis un partenaire qui peut affaiblir la cible sans la mettre K.O.',icon:'ultra-ball.png',links:[{title:'Se déplacer entre les mondes',href:'/wiki/mondes/',guide:'mondes'},{title:'Les déplacements et les points de retour',href:'/wiki/deplacements/',guide:'deplacements'}]},
  {title:'Garde le fil de tes captures',text:'Dans Ma collection, prépare tes favoris et tes chasses. Les Pokémon possédés seront suivis depuis l’équipe et les boîtes PC avec un compte Minecraft lié et un relevé du serveur.',icon:'cobblemon-pc.png',links:[{title:'Préparer mes objectifs dans Ma collection',href:'/collection/'},{title:'Vérifier la liaison Minecraft',href:'/wiki/compte/',guide:'compte'}]},
 ]},
};
const path=paths[articleId];
---
{path&&<section class="guide-path" aria-labelledby="guide-path-title"><h2 id="guide-path-title">{path.title}</h2><p class="guide-path-intro">{path.intro}</p><ol>{path.steps.map(step=><li><img src={'/collection-assets/interface/'+step.icon} width="40" height="40" alt="" loading="lazy"/><h3>{step.title}</h3><p>{step.text}</p><ul>{step.links.filter(link=>!link.guide||published.has(link.guide)).map(link=><li><a href={link.href}>{link.title}<span aria-hidden="true"> →</span></a></li>)}</ul></li>)}</ol></section>}
<style>
.guide-path{margin:0 0 38px;padding:26px;border:1px solid #70527d;border-radius:10px;background:#21172f}.guide-path h2{margin:0 0 14px;font-size:clamp(1.75rem,3vw,2.25rem);line-height:1.2;scroll-margin-top:120px}.guide-path .guide-path-intro{margin:0;max-width:74ch;color:#e3d6e9}.guide-path>ol{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;list-style:none;margin:24px 0 0;padding:0}.guide-path>ol>li{display:flex;flex-direction:column;align-items:flex-start;min-width:0;margin:0;padding:0}.guide-path img{object-fit:contain;image-rendering:pixelated;margin-bottom:14px}.guide-path h3{font-size:1.25rem;line-height:1.3;margin:0 0 10px}.guide-path p{font-size:1rem;line-height:1.65;margin:0 0 14px}.guide-path ul{list-style:none;margin:auto 0 0;padding:0;width:100%}.guide-path ul li{margin:0;padding:0}.guide-path a{display:block;min-height:44px;padding:9px 0;color:#f5ca83;font-weight:600;font-size:1rem;line-height:1.5;text-decoration:underline;text-underline-offset:4px}.guide-path a:focus-visible{outline:3px solid #c2a1e6;outline-offset:3px}@media(max-width:1000px){.guide-path>ol{grid-template-columns:1fr;gap:0}.guide-path>ol>li+li{margin-top:20px;padding-top:20px;border-top:1px solid #62476e}.guide-path p{max-width:70ch}.guide-path h3{font-size:1.375rem}.guide-path ul{margin-top:0}}@media(max-width:600px){.guide-path{padding:20px;margin-bottom:28px}}
</style>
