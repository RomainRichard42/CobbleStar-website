---
const pathname=Astro.url.pathname;
const links=[['/roadmap/','Le serveur'],['/wiki/','Wiki'],['/actualites/','Actualités'],['/vote/','Voter']];
---
<header class="astral-header site-header"><a class="astral-skip skip" href={pathname==='/'?'#mondes':'#contenu'}>Aller au contenu</a><a class="astral-brand" href="/" aria-label="CobbleStar, accueil"><img src="/media/cobblestar-logo-128.webp" alt="" width="56" height="56"/><span>COBBLE<b>STAR</b></span></a><nav class="astral-desktop" aria-label="Navigation principale">{links.map(([href,label])=><a href={href} aria-current={pathname.startsWith(href)?'page':undefined}>{label}</a>)}<a href="https://discord.gg/Sd387Ky4M">Discord ↗</a></nav><div class="astral-header-actions"><a class="astral-account" href="/compte/">Mon compte</a><a class="astral-shop" href="/boutique/" aria-current={pathname.startsWith('/boutique/')?'page':undefined}><img src="/astral/assets/stars-button-v3.webp" alt="" width="44" height="34"/>Boutique</a><details class="astral-menu"><summary>Menu <span aria-hidden="true">☰</span></summary><nav aria-label="Navigation mobile"><a href="/">Accueil</a>{links.map(([href,label])=><a href={href} aria-current={pathname.startsWith(href)?'page':undefined}>{label}</a>)}<a href="/rejoindre/">Préparer l’ouverture</a><a href="/compte/">Mon compte</a><a href="/boutique/">Boutique</a><a href="https://discord.gg/Sd387Ky4M">Discord ↗</a></nav></details></div></header>
<script>
const menu=document.querySelector<HTMLDetailsElement>('.astral-menu');
menu?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{menu.open=false}));
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&menu?.open){menu.open=false;menu.querySelector('summary')?.focus()}});
document.addEventListener('click',e=>{if(menu?.open&&e.target instanceof Node&&!menu.contains(e.target))menu.open=false});
</script>