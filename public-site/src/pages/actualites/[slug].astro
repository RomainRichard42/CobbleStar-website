---
import Layout from '../../layouts/PublicLayout.astro';
import Picture from '../../components/Picture.astro';
import {publishedNews,newsUrl,date,breadcrumbs,SITE,safeImage,type PublicLocals} from '../../lib/content';
const news=publishedNews(await (Astro.locals as PublicLocals).getNews());const article=news.articles.find(a=>a.slug===Astro.params.slug);if(!article)Astro.response.status=404;
const crumbs=[{name:'Accueil',path:'/'},{name:'Actualités',path:'/actualites/'},...(article?[{name:article.title,path:newsUrl(article)}]:[])];
const schema=article?[breadcrumbs(crumbs),{'@context':'https://schema.org','@type':'BlogPosting',headline:article.title,description:article.excerpt,datePublished:article.publishedAt,mainEntityOfPage:SITE+newsUrl(article),image:[new URL(safeImage(article.image),SITE).href],inLanguage:'fr-FR',author:{'@type':'Organization',name:'Équipe CobbleStar'},publisher:{'@id':SITE+'/#organisation'}}]:[];
---
<Layout article={!!article} publishedAt={article?.publishedAt} imageAlt={article?.title} image={article?safeImage(article.image):undefined} title={article?`${article.title} | CobbleStar`:'Actualité introuvable'} description={article?.excerpt||'Cette actualité n’est pas disponible.'} schema={schema} noindex={!article}><main id="contenu" class="public-shell"><article class="public-prose"><nav class="breadcrumbs" aria-label="Fil d’Ariane">{crumbs.map(c=><a href={c.path}>{c.name} /</a>)}</nav>
{article?<><span class="eyebrow">{article.category}</span><h1>{article.title}</h1><p class="lead">{article.excerpt}</p><p class="public-meta">Équipe CobbleStar · <time datetime={article.publishedAt}>{date(article.publishedAt)}</time></p><aside class="public-note"><p><strong>Le serveur prépare son ouverture.</strong> Cette publication décrit le développement de CobbleStar. La date d’accès public sera annoncée par l’équipe.</p></aside><Picture src={article.image} alt="" width={1000} height={560} priority/><p class="public-meta">Visuel d’illustration de l’univers Cobblemon.</p>{article.content.split(/\r?\n\s*\r?\n/).map(p=><p style="white-space:pre-line">{p}</p>)}<aside class="article-bottom"><h2>À découvrir aussi</h2><ul>{news.articles.filter(a=>a.id!==article.id).slice(0,3).map(a=><li><a href={newsUrl(a)}>{a.title}</a></li>)}<li><a href="/wiki/">Les guides du serveur</a></li><li><a href="/rejoindre/">Préparer son arrivée sur CobbleStar</a></li></ul></aside></>:<><h1>Actualité introuvable</h1><p>Cette publication n’est pas disponible.</p><a href="/actualites/" class="public-button">Toutes les actualités</a></>}
</article></main></Layout>
