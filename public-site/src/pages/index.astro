---
import Layout from '../layouts/PublicLayout.astro';
import Image from '../components/Picture.astro';
import styles from '../../../app/maquettes/site-atlas/site-atlas.module.css';
import '../styles/home.css';
import {DISCORD,newsUrl,publishedNews,date,type PublicLocals} from '../lib/content';
import {HOME_FAQ} from '../lib/faqs';
import {serverMedia} from '../lib/server-media';
const articles=await (Astro.locals as PublicLocals).getNews().then(n=>publishedNews(n).articles.slice(0,3)).catch(()=>[]);
const features=[
 {number:'01',title:'Explorer et construire',copy:'Asteria et Nébélia sont les deux mondes de CobbleStar. Explore leurs biomes, rencontre des Pokémon et installe ton foyer.',tag:'À ton rythme',href:'/roadmap/#lancement',link:'Découvrir les mondes'},
 {number:'02',title:'Faire grandir ton équipe',copy:'Capture des Pokémon, découvre la pension et avance dans les quêtes. Les métiers accompagnent tes activités préférées.',tag:'Une progression personnelle',href:'/wiki/capture/',link:'Comprendre la capture'},
 {number:'03',title:'Partager l’aventure',copy:'Retrouve d’autres dresseurs pour les raids et les échanges. Le GTS est le marché où les joueurs proposent leurs Pokémon et leurs objets.',tag:'Seul ou avec la communauté',href:'/roadmap/',link:'Voir les activités'}
];
---
<Layout title="CobbleStar — Serveur Cobblemon FR & Minecraft Pokémon" description="Découvre CobbleStar, serveur Cobblemon français en préparation : deux mondes, capture de Pokémon, quêtes et raids. Rejoins Discord pour suivre l’ouverture.">
<main id="contenu" class={styles.atlas}>
<section class={[styles.hero,'astro-home-hero home-welcome'].join(' ')} aria-labelledby="home-title">
 <div class={styles.heroCopy}>
  <div class={styles.overline}><span>OUVERTURE À VENIR</span><i/>JAVA 1.21.1</div>
  <h1 id="home-title">Ton serveur<br/><em>Cobblemon FR.</em><br/>Ton aventure.</h1>
  <p>Capture des Pokémon, construis ton foyer et pars à l’aventure avec une communauté francophone.</p>
  <p class="home-opening">Le serveur prépare son ouverture publique. La date et le launcher seront annoncés sur Discord et sur ce site.</p>
  <div class={styles.heroActions}><a class={styles.primaryButton} href={DISCORD}>Rejoindre Discord <span aria-hidden="true">↗</span></a><a class={styles.addressButton} href="#aventures"><span><small>LE PROJET</small><strong>Découvrir CobbleStar</strong></span><b aria-hidden="true">↓</b></a></div>
  <p class="home-discord-hint">Annonces d’ouverture · Échanges entre joueurs · Aide de l’équipe</p>
 </div>
 <div class={styles.heroVisual}>
  <div class={styles.heroPhoto}><div class={styles.heroWorld}><Image src="/cobblemon-lakeside.webp" alt="Illustration de l’univers Cobblemon au bord de l’eau" fill priority/><span>Univers Cobblemon</span></div><div class={styles.heroWorld}><Image src="/cobblemon-desert.webp" alt="Illustration de l’univers Cobblemon dans le désert" fill/><span>Illustration</span></div></div>
  <div class={styles.heroLogo}><Image src="/cobblestar-logo.png" alt="Dracolosse, mascotte de CobbleStar" width={430} height={430} priority/></div>
  <div class={styles.postcard}><small>DEUX MONDES À DÉCOUVRIR</small><strong>Asteria + Nébélia</strong><span>Explorer · Capturer · Construire</span></div>
  <p class="home-visual-note">Visuels d’illustration — pas des captures du serveur.</p>
 </div>
</section>
<section class="home-section" id="aventures" aria-labelledby="adventures-title">
 <div class="home-section-heading"><span class="eyebrow">CE QUI T’ATTEND À L’OUVERTURE</span><h2 id="adventures-title">Trois façons de vivre CobbleStar.</h2><p>Tu peux commencer seul, puis rencontrer des joueurs au fil de tes activités.</p></div>
 <div class="home-three">{features.map(f=><article class="home-feature"><span class="home-number">{f.number}</span><small>{f.tag}</small><h3>{f.title}</h3><p>{f.copy}</p><a href={f.href}>{f.link} <span aria-hidden="true">→</span></a></article>)}</div>
</section>
<section class="home-section home-glimpse" id="apercu" aria-labelledby="glimpse-title">
 <div class="home-section-heading"><span class="eyebrow">L’UNIVERS DU PROJET</span><h2 id="glimpse-title">Des Pokémon. Des rencontres. Ton histoire.</h2><p>{serverMedia.length?'Un aperçu du serveur en jeu, pendant sa préparation.':'Ces images illustrent l’univers Cobblemon. Les captures et vidéos de CobbleStar seront ajoutées ici lorsqu’elles seront disponibles.'}</p></div>
 <div class="home-media-grid">{serverMedia.length?serverMedia.map(media=><figure>{media.kind==='video'?<video controls playsinline muted preload="none" poster={media.poster} aria-label={media.title}><source src={media.src} type={media.src.endsWith('.webm')?'video/webm':'video/mp4'}/>Ton navigateur ne peut pas lire cette vidéo.</video>:<Image src={media.src} alt={media.title} width={900} height={506}/>}<figcaption><b>{media.title}</b><span>{media.caption}</span></figcaption></figure>):<><figure><Image src="/cobblemon-team.webp" alt="Illustration de Pokémon dans l’univers Cobblemon" width={900} height={506}/><figcaption><b>Rencontrer et collectionner</b><span>Illustration Cobblemon · aucune scène du serveur présentée ici.</span></figcaption></figure><figure><Image src="/cobblemon-berries.webp" alt="Illustration de l’exploration dans Cobblemon" width={900} height={506}/><figcaption><b>Explorer à ton rythme</b><span>Illustration Cobblemon · les lieux de CobbleStar restent à découvrir.</span></figcaption></figure></>}</div>
</section>
<section class="home-section" id="premiers-pas" aria-labelledby="first-title">
 <div class="home-section-heading"><span class="eyebrow">NOUVEAU JOUEUR</span><h2 id="first-title">Tes premiers pas, à l’ouverture.</h2><p>Pas besoin de connaître toutes les commandes pour commencer.</p></div>
 <ol class="home-three home-steps"><li><span class="home-number">01</span><h3>Prépare ton jeu</h3><p>Il te faudra Minecraft Java sur ton compte Microsoft. Le launcher Windows installera le pack compatible lorsqu’il sera disponible.</p><a href="/rejoindre/">Voir les prérequis →</a></li><li><span class="home-number">02</span><h3>Trouve tes repères</h3><p>Une fois connecté, ouvre <code>/menu</code> pour les activités et ton journal de quêtes pour les objectifs. <code>/wiki</code> donne accès aux guides.</p><a href="/wiki/welcome/">Lire le guide de départ →</a></li><li><span class="home-number">03</span><h3>Pars à la rencontre des Pokémon</h3><p>Prépare tes Poké Balls et découvre la capture. Tu pourras ensuite poursuivre les quêtes, explorer ou retrouver d’autres joueurs.</p><a href="/wiki/capture/">Préparer ta première capture →</a></li></ol>
</section>
<section class="home-section home-trust" aria-labelledby="trust-title"><div><span class="eyebrow">AVANT DE NOUS REJOINDRE</span><h2 id="trust-title">Des repères clairs.</h2><p>Les systèmes sont préparés, mais le serveur reste fermé au public jusqu’à l’annonce de l’équipe.</p></div><div><h3>Gratuit et payant</h3><p>Le launcher et le modpack seront gratuits. Une licence Minecraft Java reste nécessaire. La boutique présente séparément les Stars, cosmétiques, clés et grades avec leurs conditions.</p><h3>Règles et aide</h3><p>Le wiki explique les règles des activités. Pour les règles de communauté et les questions à l’équipe, retrouve-nous sur Discord.</p><div class="home-text-links"><a href="/wiki/">Consulter les guides →</a><a href={DISCORD}>Contacter l’équipe sur Discord ↗</a></div></div></section>
{articles.length>0&&<section class="home-section" aria-labelledby="news-title"><div class="home-section-heading"><span class="eyebrow">LE JOURNAL DU DÉVELOPPEMENT</span><h2 id="news-title">Les nouvelles de l’équipe.</h2><p>Des aperçus des systèmes en préparation. Une annonce de développement ne signifie pas que le serveur est ouvert.</p></div><div class="home-three home-news">{articles.map(article=><a class="home-news-card" href={newsUrl(article)}><small>{article.category} · <time datetime={article.publishedAt}>{date(article.publishedAt)}</time></small><h3>{article.title}</h3><p>{article.excerpt}</p><b>Lire la note →</b></a>)}</div><a class="home-more" href="/actualites/">Toutes les actualités →</a></section>}
<section class="home-section home-faq" id="faq" aria-labelledby="faq-title"><div class="home-section-heading"><span class="eyebrow">LES QUESTIONS AVANT LE DÉPART</span><h2 id="faq-title">Ce qu’il faut savoir.</h2></div>{HOME_FAQ.map(item=><details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>
<section class="home-section home-join" aria-labelledby="join-title"><Image src="/cobblestar-logo.png" alt="" width={180} height={180}/><div><span class="eyebrow">REJOINS LA COMMUNAUTÉ</span><h2 id="join-title">L’aventure commence par une rencontre.</h2><p>Discute avec les futurs joueurs, pose tes questions et suis les annonces officielles d’ouverture.</p><a class="public-button" href={DISCORD}>Rejoindre le Discord CobbleStar ↗</a><a class="home-secondary" href="/minecraft-pokemon/">Découvrir Cobblemon et Minecraft Pokémon →</a></div></section>
</main></Layout>
