---
import Layout from '../layouts/PublicLayout.astro';
import Picture from '../components/Picture.astro';
import '../styles/astral-home.css';
import {newsUrl,publishedNews,date,type PublicLocals} from '../lib/content';
import {HOME_FAQ} from '../lib/faqs';
const articles=await (Astro.locals as PublicLocals).getNews().then(n=>publishedNews(n).articles.slice(0,3)).catch(()=>[]);
const faqSchema={'@context':'https://schema.org','@type':'FAQPage',mainEntity:HOME_FAQ.map(f=>({'@type':'Question',name:f.question,acceptedAnswer:{'@type':'Answer',text:f.answer}}))};
---
<Layout cinematic title="Serveur Cobblemon français (FR) — CobbleStar" description="Découvre CobbleStar, serveur Cobblemon français en préparation : deux mondes, capture de Pokémon, quêtes et raids. Rejoins Discord pour suivre l’ouverture." schema={[faqSchema]}>
<main id="contenu">
<section class="opening-runway" aria-label="Découvrir CobbleStar">
<div class="opening-viewport">
<div class="opening-track">
<section class="opening-panel cinematic-stage" aria-labelledby="welcome-title">
<div class="game-camera" aria-hidden="true">
<img src="/astral/assets/charizard.webp" alt="" fetchpriority="high" width="1920" height="1080">
<div class="camera-shade">
</div>
</div>
<h1 id="welcome-title" tabindex="-1">
<span class="sr-only">CobbleStar, serveur Cobblemon francophone</span>
<span class="cinema-word" aria-hidden="true">
<span data-letter="0">C</span>
<span data-letter="1">O</span>
<span data-letter="2">B</span>
<span data-letter="3">B</span>
<span data-letter="4">L</span>
<span data-letter="5">E</span>
<span data-letter="6">S</span>
<span data-letter="7">T</span>
<span data-letter="8">A</span>
<span data-letter="9">R</span>
</span>
</h1>
<div class="morph-star" aria-hidden="true">
<svg viewBox="-155 -155 310 310">
<path class="morph-star-fill" d="M0-130 33.6-46.3 123.6-40.2 54.4 17.7 76.4 105.2 0 57.2-76.4 105.2-54.4 17.7-123.6-40.2-33.6-46.3Z"/>
<path class="morph-star-line" pathLength="100" d="M0-130 33.6-46.3 123.6-40.2 54.4 17.7 76.4 105.2 0 57.2-76.4 105.2-54.4 17.7-123.6-40.2-33.6-46.3Z"/>
</svg>
</div>
<div class="cinema-intro">
<p class="opening-status">
<span aria-hidden="true">✦</span> Serveur Cobblemon FR · Ouverture à venir</p>
<h2>Ton équipe.<br>Ton aventure.</h2>
<p>Un serveur Minecraft Pokémon en préparation : capture, construction et aventure entre dresseurs sur Asteria et Nébélia.</p>
<div class="cinema-actions">
<button type="button" class="btn gold" id="start-journey">Découvrir le serveur <span aria-hidden="true">→</span>
</button>
<a class="intro-skip" href="#mondes">Passer l’intro</a>
</div>
</div>
<img class="cinema-mascot" src="/astral/assets/logo.webp" alt="" aria-hidden="true" width="480" height="480">
</section>
<section class="opening-panel gameplay-section" id="gameplay" aria-labelledby="gameplay-title">
<div class="panel-heading">
<h2 id="gameplay-title" tabindex="-1">Une aventure à vivre.</h2>
<button type="button" id="video-pause" class="text-button">Mettre la vidéo en pause</button>
</div>
<div class="gameplay-player" data-video-id="HUD1ltMD2AM">
<img class="gameplay-poster" src="/astral/assets/battle.webp" alt="Pokémon de Cobblemon" width="1280" height="720">
<div id="video-host">
</div>
<button type="button" class="video-start" aria-label="Lire la vidéo officielle Cobblemon sans son">
<span aria-hidden="true">▶</span>Lire la vidéo</button>
</div>
<div class="video-meta">
<p>Vidéo officielle Cobblemon.</p>
<a href="https://www.youtube.com/watch?v=HUD1ltMD2AM">Voir sur YouTube ↗
</a>
</div>
<p id="video-status" class="sr-only" role="status">
</p>
</section>
<section class="opening-panel in-game-gallery" id="photos" aria-labelledby="photos-title">
<div class="panel-heading">
<h2 id="photos-title" tabindex="-1">Il y a tout un monde dehors.</h2>
</div>
<div class="photo-wall">
<figure class="photo-main">
<img src="/astral/assets/riding.webp" alt="Un dresseur vole sur un Ptéra au-dessus des nuages dans Cobblemon" width="1006" height="566">
<figcaption>Prendre de la hauteur</figcaption>
</figure>
<figure>
<img src="/astral/assets/lushtower.webp" alt="Une tour de pierre envahie par la végétation dans Cobblemon" width="1280" height="720">
<figcaption>Explorer les ruines</figcaption>
</figure>
<figure>
<img src="/astral/assets/pasturedpokmon.webp" alt="Des Pokémon installés dans une construction en bois dans Cobblemon" width="1920" height="1080">
<figcaption>Poser ses valises</figcaption>
</figure>
</div>
</section>
</div>
</div>
</section>
<section class="world-section" id="mondes">
<div class="section-head">
<h2>Deux noms.<br>
<span>Une communauté.</span>
</h2>
<p>Asteria et Nébélia. Des Pokémon à rencontrer, des coins à explorer et une place pour ton équipe.</p>
</div>
<div class="world-pair">
<article class="world-card world-a">
<div class="world-photo">
<img src="/astral/assets/lushtower.webp" alt="Tour dans la jungle, illustration Cobblemon pour Asteria" loading="lazy" width="1280" height="720">
</div>
<div class="world-word">ASTERIA</div>
<div class="world-bottom">
<a href="/wiki/mondes/" aria-label="Explorer Astéria et Nébélia">Explorer les mondes ↗
</a>
</div>
</article>
<article class="world-card world-n">
<div class="world-photo">
<img src="/astral/assets/shipwreckcove.webp" alt="Caverne éclairée, illustration Cobblemon pour Nébélia" loading="lazy" width="1173" height="751">
</div>
<div class="world-word">NÉBÉLIA</div>
<div class="world-bottom">
<a href="/wiki/" aria-label="Consulter les guides du serveur">Consulter le wiki ↗
</a>
</div>
</article>
</div>
</section>
<section class="activity-runway" id="activites" data-scene="activities">
<div class="activity-sticky">
<div class="activity-heading">
<h2>Et après<br>
<span>la première capture ?</span>
</h2>
<p>Une équipe à faire grandir. Des échanges à négocier. Des défis à relever ensemble.</p>
</div>
<div class="activity-viewport">
<div class="activity-track">
<article class="activity-card activity-0">
<img src="/astral/assets/riding.webp" alt="" loading="lazy" width="1006" height="566">
<div class="activity-content">
<h3>Le GTS</h3>
<p>Vends tes Pokémon et consulte les annonces des autres joueurs.</p>
<a href="/wiki/gts/">Acheter et vendre au GTS ↗
</a>
</div>
</article>
<article class="activity-card activity-1">
<img src="/astral/assets/pasturedpokmon.webp" alt="" loading="lazy" width="1920" height="1080">
<div class="activity-content">
<h3>La pension</h3>
<p>Prépare ton élevage et développe ton équipe à la pension.</p>
<a href="/wiki/daycare/">Comprendre la reproduction ↗
</a>
</div>
</article>
<article class="activity-card activity-2">
<img src="/astral/assets/battle.webp" alt="" loading="lazy" width="1280" height="720">
<div class="activity-content">
<h3>Les raids</h3>
<p>Retrouve les autres joueurs pour les combats en groupe.</p>
<a href="/wiki/raids/">Préparer un raid ↗
</a>
</div>
</article>
<article class="activity-card activity-3">
<img src="/astral/assets/berries.webp" alt="" loading="lazy" width="1200" height="675">
<div class="activity-content">
<h3>Les métiers</h3>
<p>Métiers, quêtes et Pass Dresseur donnent d’autres objectifs entre deux captures.</p>
<a href="/wiki/metiers/">Choisir son métier ↗
</a>
</div>
</article>
</div>
</div>
<div class="activity-progress" aria-hidden="true">
<span>
</span>
</div>
</div>
</section>
<section class="store-section" id="boutique">
<div class="store-head">
<div>
<h2>Un peu plus<br>
<span>de CobbleStar.</span>
</h2>
</div>
<div>
<p>Stars, grades, Cosmédex.<br>La boutique fait vivre le serveur. Découvre ce que chaque offre te réserve.</p>
<a class="btn gold" href="/boutique/">Toute la boutique<span aria-hidden="true">↗</span>

</a>
</div>
</div>
<div class="store-cards">
<a class="store-card" href="/boutique/">
<div class="store-art">
<img src="/astral/assets/stars-640.webp" alt="Illustration de la catégorie Les Stars" loading="lazy" width="640" height="347">
</div>
<div class="store-description">
<h3>Les Stars</h3>
<p>Recharge ta réserve pour les offres du serveur.</p>
<b>Découvrir ↗</b>
</div>

</a>
<a class="store-card" href="/boutique/">
<div class="store-art">
<img src="/astral/assets/ranks.svg" alt="Illustration de la catégorie Les grades" loading="lazy" width="360" height="280">
</div>
<div class="store-description">
<h3>Les grades</h3>
<p>Étoilé. Cosmique. Galactique.</p>
<b>Découvrir ↗</b>
</div>

</a>
<a class="store-card" href="/boutique/">
<div class="store-art">
<img src="/astral/assets/cosmetics.svg" alt="Illustration de la catégorie Le Cosmédex" loading="lazy" width="360" height="280">
</div>
<div class="store-description">
<h3>Le Cosmédex</h3>
<p>Effets, accessoires et apparences.</p>
<b>Découvrir ↗</b>
</div>

</a>
</div>
<div class="shop-strip">
<span>ÉTOILÉ / COSMIQUE / GALACTIQUE</span>
<span>NOVA / PULSAR / QUASAR</span>
<span>COSMÉDEX / PASS DRESSEUR</span>
</div>
</section>
<section class="creation" id="creations">
<div class="creation-visual">
<span class="creation-backword" aria-hidden="true">STAR</span>
<img src="/astral/assets/dragonite-star.png" alt="Aperçu du modèle Dracolosse Star présent dans les ressources du projet" loading="lazy" width="1200" height="1100">
</div>
<div class="creation-copy">
<h2>Tu le reconnaîtras<br>
<span>entre mille.</span>
</h2>
<p>Dracolosse Star. Des variantes, des objets et des interfaces créés pour CobbleStar.</p>

<a class="btn ink" href="/wiki/pokemon-star/">Découvrir les Pokémon Star<span aria-hidden="true">↗</span>

</a>
</div>
</section>
<section class="join-section" id="premiers-pas">
<div class="join-copy">
<h2>Il ne manque<br>
<span>plus que toi.</span>
</h2>
<a class="btn ink" href="https://discord.gg/Sd387Ky4M">Rejoindre le Discord<span aria-hidden="true">↗</span>

</a>
</div>
<div class="join-steps">
<article>
<b>01</b>
<div>
<h3>Rejoins la communauté.</h3>
<p>Les annonces, les échanges avec l’équipe et les nouvelles du projet.</p>
</div>
</article>
<article>
<b>02</b>
<div>
<h3>Découvre le serveur.</h3>
<p>Retrouve <a href="/wiki/welcome/">les premiers pas</a> et les systèmes dans le wiki.</p>
</div>
</article>
<article>
<b>03</b>
<div>
<h3>Rendez-vous à l’ouverture.</h3>
<p>Le launcher sera proposé quand le serveur sera ouvert au public.</p>
</div>
</article>
</div>
</section>
<section class="astral-news" aria-labelledby="news-title"><div class="section-head"><h2 id="news-title">Le journal<br/><span>de CobbleStar.</span></h2><a class="btn gold" href="/actualites/">Toutes les actualités →</a></div><div class="astral-news-grid">{articles.map(a=><a href={newsUrl(a)} class="astral-news-card"><Picture src={a.image} alt="" width={700} height={400}/><div><time datetime={a.publishedAt}>{date(a.publishedAt)}</time><h3>{a.title}</h3><p>{a.excerpt}</p><b>Lire l’actualité →</b></div></a>)}</div>{!articles.length&&<p>Les prochaines nouvelles du serveur seront publiées ici.</p>}</section><section class="faq"><h2>Avant de nous rejoindre.</h2>{HOME_FAQ.map(f=><details><summary>{f.question}</summary><p>{f.answer}</p></details>)}<a href="/minecraft-pokemon/">Découvrir Pokémon dans Minecraft →</a><br/><a href="/installer-cobblemon/">Installer Cobblemon pour une première partie solo →</a></section></main>
<p id="journey-status" class="sr-only" role="status" aria-atomic="true">
</p>
<div class="journey-progress" aria-hidden="true">
<span>
</span>
</div>

<script is:inline src="/astral/motion.js?v=player-audit-2" defer></script><script is:inline src="/astral/journey.js?v=player-polish-1" defer></script><script is:inline src="/astral/player.js?v=public-1" defer></script>
</Layout>
