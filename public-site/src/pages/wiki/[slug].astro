---
import Layout from '../../layouts/PublicLayout.astro';
import Blocks from '../../components/WikiBlocks.astro';
import Picture from '../../components/Picture.astro';
import {relatedGuides} from '../../lib/wiki-navigation';
import {publishedWiki,wikiUrl,breadcrumbs,SITE,safeImage,date,type PublicLocals} from '../../lib/content';
const wiki=publishedWiki(await (Astro.locals as PublicLocals).getWiki());
const article=wiki.articles.find(a=>a.id===Astro.params.slug);
if(!article)Astro.response.status=404;
const related=article?relatedGuides(article,wiki.articles):[];
const branch=wiki.branches.find(b=>b.id===article?.branchId);
const crumbs=[{name:'Accueil',path:'/'},{name:'Wiki',path:'/wiki/'},...(branch?[{name:branch.label,path:'/wiki/#'+branch.id}]:[]),...(article?[{name:article.title,path:wikiUrl(article)}]:[])];
const schema=article?[breadcrumbs(crumbs),{'@context':'https://schema.org','@type':'Article','@id':SITE+wikiUrl(article)+'#article',headline:article.title,description:article.summary,image:[new URL(safeImage(article.hero.asset),SITE).href],inLanguage:'fr-FR',...(article.modifiedAt?{dateModified:article.modifiedAt}:{}),articleSection:branch?.label,mainEntityOfPage:SITE+wikiUrl(article),author:{'@type':'Organization','@id':SITE+'/#organisation',name:'CobbleStar',url:SITE+'/'},publisher:{'@id':SITE+'/#organisation'}}]:[];
---
<Layout article={!!article} modifiedAt={article?.modifiedAt} imageAlt={article?.hero.alt} image={article?safeImage(article.hero.asset):undefined} title={article?(article.title.includes('CobbleStar')?article.title:`${article.title} — CobbleStar`):'Guide introuvable'} description={article?.summary||'Ce guide n’est pas disponible.'} noindex={!article} schema={schema}>
<main class="public-shell wiki-reading" id="contenu"><nav class="breadcrumbs" aria-label="Fil d’Ariane">{crumbs.map((c,i)=>i===crumbs.length-1?<span aria-current="page">{c.name}</span>:<><a href={c.path}>{c.name}</a><span aria-hidden="true">/</span></>)}</nav>
{article?<><header class="wiki-article-header"><span class="eyebrow">GUIDE DU SERVEUR COBBLESTAR</span><h1>{article.title}</h1><p class="lead">{article.summary}</p><p class="public-meta">Équipe CobbleStar · {article.readingMinutes} min de lecture{article.modifiedAt&&<> · Mis à jour le <time datetime={article.modifiedAt}>{date(article.modifiedAt)}</time></>}</p></header><Picture class="wiki-article-cover" src={article.hero.asset} alt={article.hero.alt} width={1200} height={400} priority/>
<div class="wiki-reading-grid"><aside class="wiki-toc"><nav aria-label="Sommaire"><strong>Dans ce guide</strong>{article.blocks.map((b,i)=>b.kind==='heading'&&<a href={`#section-${i}`}>{b.text}</a>)}</nav><a href="/wiki/">← Tous les guides</a></aside><article class="public-prose wiki-body"><details class="wiki-toc-mobile"><summary>Dans ce guide</summary><nav aria-label="Sommaire mobile">{article.blocks.map((b,i)=>b.kind==='heading'&&<a href={`#section-${i}`}>{b.text}</a>)}</nav></details><Blocks blocks={article.blocks}/>
<aside class="article-bottom"><h2>Continuer ton aventure</h2><ul>{related.map(a=><li><a href={wikiUrl(a)}>{a.title}</a></li>)}<li><a href="/wiki/">Tous les guides</a></li><li><a href="/rejoindre/">Préparer son arrivée sur CobbleStar</a></li></ul></aside></article></div></>:<><h1>Ce guide n’est pas disponible.</h1><p>Il a peut-être été retiré ou son adresse est incorrecte.</p><a href="/wiki/" class="public-button">Consulter le wiki</a></>}
</main></Layout>
<script>
document.querySelectorAll<HTMLAnchorElement>('.wiki-toc-mobile a').forEach(link=>link.addEventListener('click',()=>{
  const details=link.closest('details');if(details)details.open=false;
}));
</script>
