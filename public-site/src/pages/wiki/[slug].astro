---
import Layout from '../../layouts/PublicLayout.astro';
import Blocks from '../../components/WikiBlocks.astro';
import Picture from '../../components/Picture.astro';
import {publishedWiki,wikiUrl,breadcrumbs,SITE,safeImage,type PublicLocals} from '../../lib/content';
const wiki=publishedWiki(await (Astro.locals as PublicLocals).getWiki());
const article=wiki.articles.find(a=>a.id===Astro.params.slug);
if(!article)Astro.response.status=404;
const related=article?wiki.articles.filter(a=>a.branchId===article.branchId&&a.id!==article.id).slice(0,4):[];
const crumbs=[{name:'Accueil',path:'/'},{name:'Wiki',path:'/wiki/'},...(article?[{name:article.title,path:wikiUrl(article)}]:[])];
const schema=article?[breadcrumbs(crumbs),{'@context':'https://schema.org','@type':'Article',headline:article.title,description:article.summary,image:[new URL(safeImage(article.hero.asset),SITE).href],inLanguage:'fr-FR',mainEntityOfPage:SITE+wikiUrl(article),author:{'@type':'Organization',name:'Équipe CobbleStar'},publisher:{'@id':SITE+'/#organisation'}}]:[];
---
<Layout article={!!article} imageAlt={article?.hero.alt} image={article?safeImage(article.hero.asset):undefined} title={article?`${article.title} — Wiki CobbleStar`:'Guide introuvable'} description={article?.summary||'Ce guide n’est pas disponible.'} noindex={!article} schema={schema}>
<main class="public-shell" id="contenu"><article class="public-prose"><nav class="breadcrumbs" aria-label="Fil d’Ariane">{crumbs.map(c=><a href={c.path}>{c.name} /</a>)}</nav>
{article?<><span class="eyebrow">GUIDE DU SERVEUR COBBLESTAR</span><h1>{article.title}</h1><p class="lead">{article.summary}</p><p class="public-meta">Équipe CobbleStar · {article.readingMinutes} min de lecture · Règles du serveur</p><Picture src={article.hero.asset} alt={article.hero.alt} width={1000} height={560} priority/>
<nav class="public-nav" aria-label="Sommaire">{article.blocks.map((b,i)=>b.kind==='heading'&&<a href={`#section-${i}`}>{b.text}</a>)}</nav><Blocks blocks={article.blocks}/>
<aside class="article-bottom"><h2>Continuer ton aventure</h2><ul>{related.map(a=><li><a href={wikiUrl(a)}>{a.title}</a></li>)}<li><a href="/wiki/">Tous les guides</a></li><li><a href="/rejoindre/">Préparer son arrivée sur CobbleStar</a></li></ul></aside></>:<><h1>Ce guide n’est pas disponible.</h1><p>Il a peut-être été retiré ou son adresse est incorrecte.</p><a href="/wiki/" class="public-button">Consulter le wiki</a></>}
</article></main></Layout>
