---
import Layout from '../../layouts/PublicLayout.astro';
import {publishedWiki,wikiUrl,breadcrumbs,type PublicLocals} from '../../lib/content';
const wiki=publishedWiki(await (Astro.locals as PublicLocals).getWiki());
---
<Layout title="Wiki CobbleStar — Guides Cobblemon en français" description="Les guides officiels du serveur CobbleStar : débuter, capturer des Pokémon, utiliser la pension, progresser et comprendre les activités Cobblemon." schema={[breadcrumbs([{name:'Accueil',path:'/'},{name:'Wiki',path:'/wiki/'}])]}>
<main id="contenu" class="public-shell"><div class="public-hero"><div><span class="eyebrow">LES GUIDES DU SERVEUR</span><h1>Le wiki<br/>CobbleStar.</h1><p class="lead">{wiki.content.subtitle}</p><p>Les règles ci-dessous concernent CobbleStar. Certaines mécaniques diffèrent d’une installation standard de Cobblemon.</p><a href="/rejoindre/">Première visite ? Commence par rejoindre le serveur →</a></div><img src="/cobblemon-team.webp" width="900" height="675" alt="Une équipe de Pokémon dans Cobblemon" fetchpriority="high"/></div>
<label for="guide-search">Rechercher un guide</label><input class="public-search" id="guide-search" type="search" placeholder="Pension, capture, quêtes…"/><p id="search-status" aria-live="polite" class="public-meta">{wiki.articles.length} guides publiés</p>
<nav class="public-nav" aria-label="Catégories des guides">{wiki.branches.map(b=><a href={`#${b.id}`}>{b.label}</a>)}</nav>
{wiki.branches.map(b=><section id={b.id} class="public-section" data-guide-section><span class="eyebrow">{b.description}</span><h2>{b.label}</h2><div class="public-grid">{wiki.articles.filter(a=>a.branchId===b.id).map(a=><a class="public-card" href={wikiUrl(a)} data-guide data-search={`${a.title} ${a.summary} ${a.tags.join(' ')}`}><div><small>{a.readingMinutes} min de lecture</small><h3>{a.title}</h3><p>{a.summary}</p><strong>Lire le guide →</strong></div></a>)}</div></section>)}
{!wiki.articles.length&&<p>Les premiers guides seront publiés ici. Pour une question, retrouve l’équipe sur Discord.</p>}
</main></Layout>
<script>
 const input=document.querySelector<HTMLInputElement>('#guide-search');const cards=[...document.querySelectorAll<HTMLElement>('[data-guide]')];
 const normalize=(v:string)=>v.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLocaleLowerCase('fr');
 input?.addEventListener('input',()=>{const q=normalize(input.value.trim());for(const c of cards)c.hidden=!normalize(c.dataset.search??'').includes(q);document.querySelectorAll<HTMLElement>('[data-guide-section]').forEach(s=>s.hidden=![...s.querySelectorAll<HTMLElement>('[data-guide]')].some(c=>!c.hidden));document.getElementById('search-status')!.textContent=`${cards.filter(c=>!c.hidden).length} guide(s) trouvé(s)`;});
</script>
