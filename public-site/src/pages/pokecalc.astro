---
import PublicLayout from '../layouts/PublicLayout.astro';
const stats=[['hp','PV'],['atk','Attaque'],['def','Défense'],['spa','Atq. Spé.'],['spd','Déf. Spé.'],['spe','Vitesse']];
---
<PublicLayout title="Pokécalc CobbleStar — calculateur de dégâts Cobblemon" description="Prépare tes combats : calcule les dégâts, règle tes IV et EV et compare les formes régionales d’Astéria et de Nébélia avec les Pokémon classiques." wide>
<main class="pokecalc" id="contenu"><nav aria-label="Fil d’Ariane"><a href="/wiki/">Wiki</a><span> / </span><a href="/wiki/pokedex/">Pokédex</a><span> / Pokécalc</span></nav>
<header class="calc-heading"><div><h1>Prépare ton prochain <em>combat.</em></h1><p>Deux Pokémon. Une attaque. Les formes de CobbleStar et leurs vraies statistiques.</p></div><img src="/collection-assets/interface/cobblemon-pc.png" alt="" width="96" height="96"/></header>
<p id="calc-loading" role="status">Chargement du Pokécalc…</p>
<form id="calc-form" hidden>
<section class="calc-result" tabindex="-1" aria-labelledby="damage-title"><div><span id="damage-title">Dégâts estimés</span><strong id="damage-range">Choisis une attaque</strong><p id="damage-text">Le résultat prend en compte les paramètres ci-dessous.</p></div><div class="damage-gauge" aria-hidden="true"><i id="damage-bar"></i></div><p id="calc-error" role="alert"></p></section>
<div class="fighter-grid">{['attacker','defender'].map((side,index)=><section class="fighter" data-side={side} aria-labelledby={`${side}-title`}>
<div class="fighter-heading"><span>{index?'02 · DÉFENSEUR':'01 · ATTAQUANT'}</span><h2 id={`${side}-title`}>{index?'Qui encaisse ?':'Qui attaque ?'}</h2></div>
<label>Rechercher un Pokémon<input type="search" data-search autocomplete="off" placeholder="Dracaufeu, Astéria, Germignon…"/></label>
<label>Pokémon et forme<select name={`${side}.id`} data-species aria-describedby={`${side}-types`}></select></label>
<div class="fighter-identity"><div class="calc-portrait" data-portrait><span>Visuel de la forme</span></div><div><p class="type-list" id={`${side}-types`} data-types></p><p data-form-note></p><a data-dex-link href="/wiki/pokedex/">Voir sa fiche →</a></div></div>
<div class="fighter-settings"><label>Niveau<input name={`${side}.level`} type="number" min="1" max="100" value="50" required/></label><label>Nature<select name={`${side}.nature`} data-nature></select></label><label>Talent<select name={`${side}.ability`} data-ability></select></label><label>Objet tenu<select name={`${side}.item`} data-item><option value="">Aucun</option></select></label></div>
<details class="stat-details" open><summary>Statistiques, IV et EV <span data-ev-total>0 / 510 EV</span></summary><table><caption class="sr-only">Statistiques du {index?'défenseur':'attaquant'}</caption><thead><tr><th>Stat.</th><th>Base</th><th>IV</th><th>EV</th><th>Bonus</th><th>Total</th></tr></thead><tbody>{stats.map(([id,name])=><tr><th scope="row">{name}</th><td data-base={id}>—</td><td><input aria-label={`${name} IV ${index?'défenseur':'attaquant'}`} name={`${side}.ivs.${id}`} type="number" min="0" max="31" value="31" required/></td><td><input aria-label={`${name} EV ${index?'défenseur':'attaquant'}`} name={`${side}.evs.${id}`} type="number" min="0" max="252" value="0" required/></td><td>{id==='hp'?<span>—</span>:<input aria-label={`${name} bonus ${index?'défenseur':'attaquant'}`} name={`${side}.boosts.${id}`} type="number" min="-6" max="6" value="0" required/>}</td><td data-total={id}>—</td></tr>)}</tbody></table></details>
<details><summary>PV, statut et Téracristallisation</summary><div class="fighter-settings"><label>PV restants (%)<input name={`${side}.hpPercent`} type="number" min="1" max="100" value="100" required/></label><label>Statut<select name={`${side}.status`}><option value="">Aucun</option><option value="brn">Brûlure</option><option value="par">Paralysie</option><option value="psn">Poison</option><option value="tox">Poison grave</option><option value="slp">Sommeil</option><option value="frz">Gel</option></select></label><label>Type Téracristal<select name={`${side}.teraType`} data-tera><option value="">Désactivé</option></select></label></div></details>
</section>)}</div>
<section class="conditions"><h2>L’attaque et le terrain</h2><div class="conditions-grid"><label>Attaque de l’attaquant<select name="move" id="calc-move" required></select></label><label>Format<select name="gameType"><option value="Singles">Combat simple</option><option value="Doubles">Combat double / duo</option></select></label><label>Météo<select name="weather"><option value="">Aucune</option><option value="Sun">Soleil</option><option value="Rain">Pluie</option><option value="Sand">Tempête de sable</option><option value="Snow">Neige</option><option value="Harsh Sunshine">Soleil intense</option><option value="Heavy Rain">Pluie battante</option><option value="Strong Winds">Vents mystérieux</option></select></label><label>Champ<select name="terrain"><option value="">Aucun</option><option value="Electric">Électrifié</option><option value="Grassy">Herbu</option><option value="Misty">Brumeux</option><option value="Psychic">Psychique</option></select></label></div>
<div class="condition-checks">{[['critical','Coup critique'],['reflect','Protection'],['lightScreen','Mur Lumière'],['auroraVeil','Voile Aurore'],['helpingHand','Coup d’Main'],['friendGuard','Garde Amie']].map(([id,label])=><label><input type="checkbox" name={id}/>{label}</label>)}</div><button type="submit" class="calculate-button">Calculer les dégâts</button><p id="calc-announcement" class="sr-only" aria-live="polite"></p></section>
</form>
<section class="calc-explain"><h2>Les formes régionales sont prises en compte.</h2><p>Un Dracaufeu d’Astéria possède le type Feu / Électrik. Sa résistance, ses faiblesses et le bonus de ses attaques changent donc par rapport au Dracaufeu classique. Choisis toujours la bonne forme dans le sélecteur.</p><p>Les apparences Shiny et Star ne changent pas les dégâts. Ce calculateur simule les combats Pokémon de génération 9 ; les PV et les mécaniques spéciales des boss de raid ne sont pas reproduits.</p><p>Pour vérifier une attaque, une évolution ou un lieu de rencontre, retrouve les <a href="/wiki/pokedex/">fiches du Pokédex</a>. Les calculs s’appuient sur le <a href="https://github.com/smogon/damage-calc" target="_blank" rel="noreferrer">moteur de Smogon</a>.</p></section>
</main>
<script>import '../scripts/pokecalc';</script>
<style is:global>
.pokecalc{max-width:1300px;margin:auto;padding:38px 24px 72px;color:#ede2f2;font-size:16px}.pokecalc :is(h1,h2){letter-spacing:normal}.pokecalc nav{color:#b9a5c8;font-size:15px}.pokecalc a{color:#f2ce88}.calc-heading{display:flex;align-items:center;justify-content:space-between;gap:24px;margin:25px 0 32px}.calc-heading h1{font-size:clamp(34px,4vw,56px);line-height:1.1;color:#fff2d7;margin:0 0 16px}.calc-heading h1 em{font-style:normal;color:#bd9be1}.calc-heading p{max-width:700px;margin:0;font-size:18px;color:#cbbdd8}.calc-heading img{image-rendering:pixelated}.pokecalc label{display:grid;gap:7px;font-size:15px;color:#d3c4df}.pokecalc input,.pokecalc select{background:#100b1c;color:#fff0d8;border:1px solid #624b78;border-radius:8px;min-height:44px;padding:8px 10px;font:inherit;min-width:0;width:100%}.pokecalc input[type=checkbox]{width:21px;min-height:21px;accent-color:#e5bc73}.pokecalc :is(button,input,select,summary,a):focus-visible{outline:3px solid #b5e7f1;outline-offset:3px}.calc-result{scroll-margin-top:120px;background:#20152d;border:1px solid #76588b;border-left:4px solid #e7bd76;border-radius:10px;padding:22px 26px;margin:26px 0}.calc-result strong{display:block;font-size:clamp(25px,3vw,38px);color:#ffdb91;margin:7px 0}.calc-result p{margin:5px 0;color:#d1bedb;line-height:1.6}.damage-gauge{height:10px;background:#362640;border-radius:6px;margin-top:17px;overflow:hidden}.damage-gauge i{display:block;height:100%;width:0;background:#eac37f}.fighter-grid{display:grid;grid-template-columns:1fr 1fr;gap:22px}.fighter{min-width:0;background:#171021;border:1px solid #513b67;border-radius:12px;padding:24px}.fighter-heading{border-bottom:1px solid #4b355c;padding-bottom:15px;margin-bottom:20px}.fighter-heading>span{font-size:13px;letter-spacing:.09em;color:#c39de5}.fighter h2{font-size:31px;color:#fff0d5;margin:6px 0 0}.fighter>label{margin:14px 0}.fighter-identity{display:flex;gap:22px;align-items:center;min-height:132px}.calc-portrait{width:150px;height:125px;flex-shrink:0;display:grid;place-items:center;background:radial-gradient(ellipse,#67437d50,transparent 70%);color:#ad97ba;font-size:13px;text-align:center}.calc-portrait canvas{width:150px;height:125px;object-fit:contain}.type-list{display:flex;gap:7px;flex-wrap:wrap;margin:0}.type-list span{padding:5px 10px;border-radius:5px;color:#fff;font-size:13px;font-weight:700;background:#5b496b}.fighter-identity p{font-size:14px;line-height:1.4}.fighter-settings,.conditions-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.pokecalc details{border-top:1px solid #4d365d;margin-top:20px;padding-top:15px}.pokecalc summary{cursor:pointer;min-height:44px;color:#f0d5a6;font-weight:650}.pokecalc summary span{float:right;color:#b9a4cc;font-size:13px}.stat-details table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:13px}.stat-details th:first-child{width:24%;text-align:left}.stat-details th{padding:8px 3px;color:#bca8cb;font-weight:500}.stat-details td{padding:4px 3px;text-align:center}.stat-details tbody tr:nth-child(odd){background:#21162d}.stat-details input{width:100%;padding:3px;min-height:44px;text-align:center;font-size:14px}.stat-details [data-total]{color:#efd19b;font-weight:700}.conditions{margin-top:24px;padding:26px;border:1px solid #5b426b;background:#1a1225;border-radius:12px}.conditions h2{color:#ffefd6;font-size:30px;margin:0 0 22px}.conditions-grid{grid-template-columns:2fr 1fr 1fr 1fr}.condition-checks{display:flex;flex-wrap:wrap;gap:18px 26px;margin:24px 0}.condition-checks label{display:flex;align-items:center}.condition-checks select{width:auto}.calculate-button{background:#f0c77f;border:0;border-radius:8px;padding:14px 26px;color:#21132a;font-family:inherit;font-size:18px;font-weight:700;min-height:48px;cursor:pointer}.calculate-button:disabled{opacity:.6}.calc-explain{max-width:930px;margin:50px 0 0;line-height:1.8;color:#bcadc8}.calc-explain h2{font-size:30px;color:#eddaed;line-height:1.2}.pokecalc #calc-error{color:#ffb1ad}.pokecalc [hidden]{display:none!important}@media(max-width:800px){.fighter-grid{grid-template-columns:1fr}.pokecalc{padding:26px 16px 45px}.conditions-grid{grid-template-columns:1fr 1fr}.calc-heading img{width:64px;height:64px}.fighter{padding:17px}.calc-result{padding:18px}.calc-heading p{font-size:16px}}@media(max-width:410px){.conditions-grid{grid-template-columns:1fr}.calc-portrait{width:115px}.fighter-identity{gap:12px}.stat-details table{font-size:12px}.stat-details th:first-child{width:23%}.fighter-settings{gap:10px}.calc-heading img{display:none}}@media(prefers-reduced-motion:reduce){.pokecalc *{scroll-behavior:auto}}
</style>
</PublicLayout>
